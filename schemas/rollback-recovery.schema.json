{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quoralinex.github.io/AI-Delivery-Standard/schemas/rollback-recovery.schema.json",
  "title": "Rollback Recovery",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "recovery_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "immutable_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "immutable_ref"
        ]
      }
    },
    "rollback_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preserve": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "destructive_actions_require_human_approval": {
      "const": true
    }
  },
  "required": [
    "schema_version",
    "delivery_id",
    "recovery_points",
    "rollback_steps",
    "preserve",
    "destructive_actions_require_human_approval"
  ]
}
