{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quoralinex.github.io/AI-Delivery-Standard/schemas/secret-requirements.schema.json",
  "title": "Secret Requirements",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "required": {
            "type": "boolean"
          },
          "storage": {
            "type": "string",
            "minLength": 1
          },
          "exportable": {
            "const": false
          },
          "rotation_supported": {
            "type": "boolean"
          }
        },
        "required": [
          "required",
          "storage",
          "exportable",
          "rotation_supported"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "delivery_id",
    "requirements"
  ]
}
