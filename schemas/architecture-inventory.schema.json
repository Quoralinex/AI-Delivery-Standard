{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quoralinex.github.io/AI-Delivery-Standard/schemas/architecture-inventory.schema.json",
  "title": "Architecture Inventory",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "kind",
          "location",
          "authority",
          "depends_on"
        ]
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to",
          "protocol",
          "purpose"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "delivery_id",
    "components",
    "connections"
  ]
}
