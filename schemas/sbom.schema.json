{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quoralinex.github.io/AI-Delivery-Standard/schemas/sbom.schema.json",
  "title": "Sbom",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "type"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "delivery_id",
    "components"
  ]
}
