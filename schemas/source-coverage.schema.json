{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quoralinex.github.io/AI-Delivery-Standard/schemas/source-coverage.schema.json",
  "title": "Source Coverage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "BLOCKED_INCOMPLETE"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "identifier": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "identifier"
        ]
      }
    },
    "known_missing_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "status",
    "sources",
    "known_missing_sources"
  ]
}
