{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quoralinex.github.io/AI-Delivery-Standard/schemas/deployment-inventory.schema.json",
  "title": "Deployment Inventory",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "endpoint": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "component_id",
          "provider",
          "resource_id",
          "status"
        ]
      }
    },
    "repository_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "repository",
          "ref",
          "sha"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "delivery_id",
    "environment",
    "instances",
    "repository_refs"
  ]
}
